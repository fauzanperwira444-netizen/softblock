{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install -g pnpm@12.21.0 && pnpm install --frozen-lockfile --filter web",
  "buildCommand": "VITE_DEMO=on pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
